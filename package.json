{
  "name": "svelte-collection-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "data": "node scripts/build-data.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "pairs": "node scripts/build-pairs.mjs",
    "train": "node experiments/train-head.mjs",
    "rerank": "node experiments/rerank.mjs",
    "calibrate": "node scripts/calibrate.mjs",
    "test:service": "PYTHONPATH=. service/.venv/bin/python -m pytest service -q",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^3.8.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4"
  }
}
